# Copia este archivo como .env y llena los valores reales.
# El .env NO se sube a GitHub; este .env.example sí (sin datos secretos).

FLASK_SECRET_KEY=pega-aqui-una-clave-larga-aleatoria
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Usa la clave "publishable" (o "anon" si tu proyecto muestra las legacy).
# NUNCA uses la "secret" / "service_role" aquí.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
